# Base URL of the backend API.
#
# Local dev: the backend runs on its own port, separate from the Vite dev
# server, so this needs the full origin plus the /api prefix.
VITE_API_URL=http://localhost:8000/api

# Production build: the frontend and backend share one domain behind
# CloudFront (the default behavior serves the S3 frontend, /api/* routes to
# the backend), so this should just be the relative path:
#   VITE_API_URL=/api
# Vite bakes this value into the build at build time (see README), so set it
# before running `npm run build` for deployment - changing it afterward
# means rebuilding, not just re-uploading.
