# SQLite for local dev. Swap for a PostgreSQL URL in production, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./paper_trading.db

# Secret used to sign JWT tokens. Generate your own random string for real use,
# e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret

# Finnhub API key (https://finnhub.io) - used starting in Phase 2.
FINNHUB_API_KEY=your-finnhub-api-key-here

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
