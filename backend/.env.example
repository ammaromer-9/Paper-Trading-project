# Database connection string.
# - Local dev (SQLite, default if unset): sqlite:///./paper_trading.db
# - Production (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./paper_trading.db

# Secret used to sign JWT login tokens. Required - the app refuses to start
# without it. Generate your own random string, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Run that command in your terminal and paste its output here - don't paste
# the command itself.
JWT_SECRET=

# How long a login token stays valid, in minutes. Optional, defaults to 60.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Finnhub API key (https://finnhub.io) for live stock prices. Required - the
# app refuses to start without it. Get a free key at finnhub.io/register.
FINNHUB_API_KEY=

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Optional, defaults to the local Vite dev server.
CORS_ORIGINS=http://localhost:5173
